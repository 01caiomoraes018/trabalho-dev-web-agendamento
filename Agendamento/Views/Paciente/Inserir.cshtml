@model Agendamento.Models.Paciente
@{ ViewData["Title"] = "Inserir paciente"; }
<h1>Inserir paciente</h1>
<div class="row"><div class="col-md-6">
    <form asp-action="Inserir"  method="post">
        
        <partial name="_Campos" model="Model" />
        <button type="submit" class="btn btn-success">Salvar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
